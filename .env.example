# Discord
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_APPLICATION_ID=replace-with-discord-application-id
# Comma-separated Discord server IDs. Commands are registered only here.
DISCORD_ALLOWED_GUILD_IDS=replace-with-guild-id
DISCORD_HTTP_TIMEOUT=15s

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=jobbot
MYSQL_USER=jobbot
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=3m

# OpenAI-compatible LLM API
LLM_BASE_URL=https://api.example.com
LLM_API_KEY=replace-with-api-key
LLM_MODEL=replace-with-model-name
# Supported values: none, low, medium, high, xhigh, max.
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=30s
LLM_MAX_DESCRIPTION_RUNES=12000

# Scheduler
SCHEDULER_INTERVAL=5m
SCHEDULER_RESULTS_WANTED=50
SCHEDULER_HOURS_OLD=24
SCHEDULER_RUN_TIMEOUT=10m

# LinkedIn
# Optional custom browser user agent. Leave empty to use the built-in default.
LINKEDIN_USER_AGENT=
